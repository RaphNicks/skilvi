# Copy to .env and fill in. Do not commit real passwords.
# OTP login codes are sent with these settings.

# Public site URL (no trailing slash). Used as the Paystack callback.
# Local XAMPP example: http://127.0.0.1:8080
APP_URL=

# Paystack — test keys on this machine only. Live keys only on the server.
# Never commit, and never paste keys into chat.
PAYSTACK_SECRET=
PAYSTACK_PUBLIC=

# Google sign-in — test credentials on this machine only. Never commit or paste into chat.
# Authorized redirect: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_MAILER=
MAIL_SCHEME=
MAIL_ENCRYPTION=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_EHLO_DOMAIN=
